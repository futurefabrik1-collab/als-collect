<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hardened-runtime exceptions a PyInstaller + pyobjc app needs:
     pyobjc/libffi closures (blocks, callbacks) need writable+executable memory,
     and Python extension modules are signed separately from the main binary,
     so library validation has to be off. -->
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
    <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
